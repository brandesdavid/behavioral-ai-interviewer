# Copy to .dev.vars for `npx wrangler dev`. .dev.vars is not committed.
# Set the key that matches LLM_PROVIDER in wrangler.jsonc (the default is openai).
# In the Cloudflare dashboard these are Worker secrets, not [vars].

OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=sk-ant-your-claude-key

# Optional. If empty, the session signature key is derived from the provider API key.
SESSION_SECRET=

# Optional. Enables GET /export?password=... when the DB binding exists.
ADMIN_PASSWORD=
